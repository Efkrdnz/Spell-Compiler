{
  "name": "spell-compiler",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A programmable magic sandbox: invent spells with a typed node graph, compile them, and cast them in a physics arena.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "lz-string": "^1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
